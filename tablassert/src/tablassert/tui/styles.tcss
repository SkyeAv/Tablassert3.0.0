Screen {
    layout: horizontal;
}

#intro-container {
    align: center middle;
    height: 100%;
    width: 100%;
}

#intro-markdown {
    width: 80%;
    height: auto;
    text-align: center;
}

#sidebar {
    layout: horizontal;
    dock: top;
    height: 3;
    width: 100%;
    align-vertical: middle;
    background: $boost;
}

Button:hover {
    background: $accent;
}

.sidebar.buttons {
    content-align: center middle;
    padding: 0 1;  
}

#build-instructions {
    width: 1fr;
}

#build-markdown {
    width: 1fr;
    height: 1fr;
    text-align: left;
    background: $background;
}

#build-file-selector{
    width: 2fr;
}

#build-directory-tree {
    background: $background;
    border: wide $primary;
}

#build-are-you-sure-container {
    height: 100%;
    width: 2fr;
    align: center middle;
    layout: vertical;
    content-align: center middle;
    border: wide $primary;
    padding: 2;
}

#build-are-you-sure {
    text-align: center;
    margin-bottom: 1;
}

#build-selected-path {
    text-align: center;
    color: $secondary;
    margin-bottom: 1;
}

#buttons-in-build-are-you-sure-container {
    layout: horizontal;
    align: center middle;
}